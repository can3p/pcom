# Copy to cmd/web/.env for running the app on the host (`go run ./cmd/web`)
# against the compose stack (`make dev-up`). The app loads it with godotenv,
# which never overrides a variable that is already set, so the compose `app`
# service (make dev) sets the in-network values below as real environment
# variables and this file serves both modes.
#
# Host ports published by docker-compose.yml:
#
#   host port  what answers                          in-network equivalent
#   5442       Postgres 16 (db/user/password pcom)   postgres:5432
#   8811       tommy UI (/ui/) and API (/api/v1/)    tommy:8811
#              read mail at http://localhost:8811/ui/
#   8822       tommy fake vendor ingress             tommy:8822
#   9555       tommy S3, bucket pcom-media           tommy:9000
#   8080       the app                               app:8080

DATABASE_URL=postgres://pcom:pcom@localhost:5442/pcom?sslmode=disable
SESSION_SALT=local-dev-session-salt-change-me
SITE_ROOT=http://localhost:8080
PORT=8080

# Mail goes to tommy's fake Mailjet API; read it at http://localhost:8811/ui/.
SENDER_ADDRESS=pcom@localhost
MJ_APIKEY_PUBLIC=dev
MJ_APIKEY_PRIVATE=dev
MJ_API_BASE=http://localhost:8822

# Production defaults that don't fit plain-HTTP localhost (`web serve --help`
# lists every setting).
SECURE_COOKIES=false
HSTS=false
STATIC_CACHE=false
MEDIA_PERMA_CACHE=false
SHOW_ERRORS=true
DEV_ROUTES=true
REPORT_PANICS=false
LOG_LEVEL=debug
LOG_FORMAT=console

# Object storage (tommy; it only answers path-style requests).
USER_MEDIA_ENDPOINT=http://localhost:9555
USER_MEDIA_BUCKET=pcom-media
USER_MEDIA_REGION=us-east-1
USER_MEDIA_KEY=dev
USER_MEDIA_SECRET=dev
USER_MEDIA_PATH_STYLE=true

# Grammar checks and style reviews call the Claude API and are off without a
# key: no buttons, no panel, and their routes answer 404. Set a key of your
# own to try them; the other PROOFREAD_* settings (models, efforts, hourly
# limits) are listed in `web serve --help`.
# PROOFREAD_ANTHROPIC_KEY=sk-ant-...
# Most characters of an author note to a style review or a reason to keep a note.
# PROOFREAD_NOTE_MAX_LENGTH=2000

# Voice notes are transcribed by a speech-to-text backend; without a provider
# transcription is off. Locally the backend is the WireMock stub of
# docker-compose.yml (`make dev-up`), which answers with canned transcripts.
# The other STT_* settings (timeout, workers, daily minutes, model) are listed
# in `web serve --help`.
STT_PROVIDER=openai-compat
STT_OPENAI_COMPAT_ENDPOINT=http://localhost:8833/openai-compat
STT_OPENAI_COMPAT_KEY=dev

# Address checks of the subscribe form. Local development, where addresses
# are made up, turns the DNS check off and accepts throwaway addresses. A
# domain the check accepted is remembered for EMAIL_MX_CACHE, for up to
# EMAIL_MX_CACHE_SIZE domains; 0 in either turns the cache off. A refused
# domain is checked again next time.
# EMAIL_MX_TIMEOUT=2s
# EMAIL_MX_CACHE=1h
# EMAIL_MX_CACHE_SIZE=10000
# EMAIL_ALLOW_DISPOSABLE=false

# Email subscriptions to authors; the defaults are shown.
# How long a confirmation link works, and how many confirmation and
# manage-link mails one address may get.
# SUBSCRIBE_CONFIRM_LIFETIME=72h
# SUBSCRIBE_CONFIRMS_PER_ADDRESS=3
# SUBSCRIBE_MANAGE_LINKS_PER_ADDRESS=3
# Confirmation mails the whole site may send per hour.
# SUBSCRIBE_CONFIRMS_PER_HOUR=100
# DNS lookups of subscribing addresses' domains the whole site may make per
# hour; past it addresses go through unchecked.
# SUBSCRIBE_DOMAIN_LOOKUPS_PER_HOUR=300
# The subscribe form's proof of work (leading zero bits, how long a challenge
# may be answered) and the least time between showing and submitting it.
# SUBSCRIBE_POW_DIFFICULTY=15
# SUBSCRIBE_POW_MAX_AGE=30m
# SUBSCRIBE_MIN_FILL_TIME=2s
# How often expired subscriptions and old mail records are deleted.
# SUBSCRIBE_PRUNE_EVERY=1h

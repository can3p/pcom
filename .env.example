# Copy to cmd/web/.env for running the app on the host (`go run ./cmd/web`)
# against the compose stack (`make dev-up`). The app loads it with godotenv,
# which never overrides a variable that is already set, so the compose `app`
# service (make dev) sets the in-network values below as real environment
# variables and this file serves both modes.
#
# Host ports published by docker-compose.yml:
#
#   host port  what answers                          in-network equivalent
#   5442       Postgres 16 (db/user/password pcom)   postgres:5432
#   8811       tommy UI (/ui/) and API (/api/v1/)    tommy:8811
#              read mail at http://localhost:8811/ui/
#   8822       tommy fake vendor ingress             tommy:8822
#   9555       tommy S3, bucket pcom-media           tommy:9000
#   8080       the app                               app:8080

DATABASE_URL=postgres://pcom:pcom@localhost:5442/pcom?sslmode=disable
SESSION_SALT=local-dev-session-salt-change-me
SITE_ROOT=http://localhost:8080
PORT=8080

# Object storage and mail both go to tommy, but the app only uses them in
# cluster (or with -force-real-sender) until a later refactor points them at a
# configurable endpoint. The values tommy would take:
# S3 (path-style, any credentials; objects listed at
# http://localhost:8811/api/v1/s3/buckets/pcom-media/objects):
# USER_MEDIA_ENDPOINT=http://localhost:9555
# USER_MEDIA_BUCKET=pcom-media
# USER_MEDIA_REGION=us-east-1
# USER_MEDIA_KEY=dev
# USER_MEDIA_SECRET=dev
# Mailjet v3.1 send API (captured at http://localhost:8811/ui/):
# MJ_APIKEY_PUBLIC=dev
# MJ_APIKEY_PRIVATE=dev
# SENDER_ADDRESS=pcom@localhost

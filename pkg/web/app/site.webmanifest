{
  "name": "pcom",
  "short_name": "pcom",
  "start_url": "/controls/notes/new",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "icons": [
    { "src": "static/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "static/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "Dictate", "url": "/controls/notes/new?start=voice" },
    { "name": "Photo", "url": "/controls/notes/new?start=photo" }
  ],
  "share_target": {
    "action": "/controls/notes/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "audio", "accept": ["audio/*"] },
        { "name": "image", "accept": ["image/*"] }
      ]
    }
  }
}

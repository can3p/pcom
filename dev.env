# The app's settings in the local stack (`make dev`; `make seed` runs the same
# service). docker-compose.yml loads this file, then local.env (gitignored,
# optional) on top of it: put your own keys and overrides there, starting from
# local.env.example. `go run ./cmd/web serve --help` lists every setting; the
# defaults are production values, so this file turns off what doesn't fit
# plain-HTTP localhost. Hosts are compose service names. SITE_ROOT is set in
# docker-compose.yml, which knows the published port.

DATABASE_URL=postgres://pcom:pcom@postgres:5432/pcom?sslmode=disable
SESSION_SALT=local-dev-session-salt-change-me
PORT=8080

# Mail goes to tommy's fake Mailjet API; read it at http://localhost:8811/ui/.
SENDER_ADDRESS=pcom@localhost
MJ_APIKEY_PUBLIC=dev
MJ_APIKEY_PRIVATE=dev
MJ_API_BASE=http://tommy:8822

# Object storage: tommy's S3, which only answers path-style requests.
USER_MEDIA_ENDPOINT=http://tommy:9000
USER_MEDIA_BUCKET=pcom-media
USER_MEDIA_REGION=us-east-1
USER_MEDIA_KEY=dev
USER_MEDIA_SECRET=dev
USER_MEDIA_PATH_STYLE=true

# Production defaults that don't fit plain-HTTP localhost.
SECURE_COOKIES=false
HSTS=false
STATIC_CACHE=false
MEDIA_PERMA_CACHE=false
SHOW_ERRORS=true
DEV_ROUTES=true
REPORT_PANICS=false
LOG_LEVEL=debug
LOG_FORMAT=console

# Addresses are made up locally: no DNS check, throwaway domains accepted.
EMAIL_MX_TIMEOUT=0
EMAIL_ALLOW_DISPOSABLE=true

# Voice notes are transcribed by the WireMock stub, which answers with canned
# transcripts.
STT_PROVIDER=openai-compat
STT_OPENAI_COMPAT_ENDPOINT=http://wiremock:8080/stt
STT_OPENAI_COMPAT_KEY=dev

Usage:
  web [OPTIONS] serve [serve-OPTIONS]

Serve the site, send queued mail and poll RSS feeds.

Help Options:
  -h, --help                                           Show this help message

[serve command options]

    Database:
          --database-url=                              Postgres connection URL
                                                       [$DATABASE_URL]

    Web:
          --site-root=                                 Public root URL of the
                                                       site, such as
                                                       https://pcom.example;
                                                       absolute links start
                                                       with it [$SITE_ROOT]
          --session-salt=                              Salt for session cookies
                                                       and hashed values
                                                       [$SESSION_SALT]
          --port=                                      Port to listen on
                                                       (default: 8080) [$PORT]
          --gin-mode=                                  gin mode: debug, release
                                                       or test; gin's own
                                                       default if empty
                                                       [$GIN_MODE]
          --html-dir=                                  Template directory,
                                                       relative to the working
                                                       directory (default:
                                                       client/html) [$HTML_DIR]
          --force-signup=                              Allow new signups even
                                                       when system settings
                                                       close them (default:
                                                       false) [$FORCE_SIGNUP]
          --static-cdn=                                Origin that serves
                                                       /static, such as
                                                       https://cdn.example;
                                                       served by the app if
                                                       empty [$STATIC_CDN]
          --read-header-timeout=                       How long a client may
                                                       take to send the request
                                                       headers (default: 10s)
                                                       [$READ_HEADER_TIMEOUT]
          --read-timeout=                              How long a client may
                                                       take to send a whole
                                                       request, upload included
                                                       (default: 60s)
                                                       [$READ_TIMEOUT]
          --write-timeout=                             How long a response may
                                                       take from the end of the
                                                       request headers; keep it
                                                       above
                                                       --proofread-timeout
                                                       (default: 120s)
                                                       [$WRITE_TIMEOUT]
          --idle-timeout=                              How long an idle
                                                       keep-alive connection
                                                       stays open (default:
                                                       120s) [$IDLE_TIMEOUT]
          --shutdown-timeout=                          How long requests in
                                                       flight may run after
                                                       SIGINT or SIGTERM before
                                                       the server closes them
                                                       (default: 4s)
                                                       [$SHUTDOWN_TIMEOUT]
          --session-max-age=                           How long a session lasts
                                                       after its last save; the
                                                       session cookie and its
                                                       row expire then
                                                       (default: 720h)
                                                       [$SESSION_MAX_AGE]
          --session-cleanup-interval=                  How often expired
                                                       sessions are deleted
                                                       from the database
                                                       (default: 1h)
                                                       [$SESSION_CLEANUP_INTERV-

                                                       AL]
          --secure-cookies=                            Mark the session cookie
                                                       Secure (turn off for
                                                       plain-HTTP localhost)
                                                       (default: true)
                                                       [$SECURE_COOKIES]
          --hsts=                                      Send
                                                       Strict-Transport-Securit-

                                                       y (default: true) [$HSTS]
          --static-cache=                              Serve /static with a
                                                       long immutable
                                                       Cache-Control (default:
                                                       true) [$STATIC_CACHE]
          --media-perma-cache=                         Keep resized user media
                                                       in the media server's
                                                       permanent cache
                                                       (default: true)
                                                       [$MEDIA_PERMA_CACHE]
          --show-errors=                               Show error details in
                                                       pages (development only)
                                                       (default: false)
                                                       [$SHOW_ERRORS]
          --report-panics=                             Mail the admin address
                                                       when a page panics
                                                       (default: true)
                                                       [$REPORT_PANICS]
          --log-level=[debug|info|warn|error]          Log level (default:
                                                       info) [$LOG_LEVEL]
          --log-format=[json|console]                  Log encoding on stdout:
                                                       json for the deployed
                                                       app, console for a
                                                       terminal (default: json)
                                                       [$LOG_FORMAT]
          --enable-pprof=                              Serve net/http/pprof on
                                                       :8081 (default: false)
                                                       [$ENABLE_PPROF]
          --dev-routes=                                Serve the /dev pages
                                                       (mail previews); local
                                                       development only
                                                       (default: false)
                                                       [$DEV_ROUTES]

    Mail:
          --sender-address=                            From address of every
                                                       mail [$SENDER_ADDRESS]
          --admin-address=                             Where admin
                                                       notifications (signups,
                                                       page failures) go
                                                       [$ADMIN_ADDRESS]
          --email-retry-intervals=                     Waits between attempts
                                                       to send a mail; a mail
                                                       fails after one attempt
                                                       more than there are
                                                       waits (default: 10s,
                                                       60s, 30m)
                                                       [$EMAIL_RETRY_INTERVALS]

    Mailjet:
          --mj-api-key-public=                         Mailjet API key public
                                                       [$MJ_APIKEY_PUBLIC]
          --mj-api-key-private=                        Mailjet API key private
                                                       [$MJ_APIKEY_PRIVATE]
          --mj-api-base=                               Mailjet API root, such
                                                       as a mock's
                                                       http://localhost:8822;
                                                       Mailjet's own if empty
                                                       [$MJ_API_BASE]
          --mj-timeout=                                How long one request to
                                                       the Mailjet API may take
                                                       (default: 30s)
                                                       [$MJ_TIMEOUT]

    Jobs:
          --jobs-poll-interval=                        How often the job runner
                                                       looks for jobs to work
                                                       (default: 1s)
                                                       [$JOBS_POLL_INTERVAL]
          --jobs-workers=                              How many jobs the runner
                                                       works at once (default:
                                                       10) [$JOBS_WORKERS]
          --jobs-retention=                            How long finished jobs
                                                       are kept (default: 24h)
                                                       [$JOBS_RETENTION]

    Limits:
          --profile-about-max-length=                  Most characters a user's
                                                       About text may have
                                                       (default: 6000)
                                                       [$PROFILE_ABOUT_MAX_LENG-

                                                       TH]
          --comment-max-length=                        Most characters a
                                                       comment may have
                                                       (default: 6000)
                                                       [$COMMENT_MAX_LENGTH]
          --post-body-max-length=                      Most characters a post
                                                       body may have (default:
                                                       20000)
                                                       [$POST_BODY_MAX_LENGTH]
          --post-subject-max-length=                   Most characters a post
                                                       subject may have
                                                       (default: 100)
                                                       [$POST_SUBJECT_MAX_LENGT-

                                                       H]
          --prompt-max-length=                         Most characters a prompt
                                                       message may have
                                                       (default: 1400)
                                                       [$PROMPT_MAX_LENGTH]
          --user-styles-max-length=                    Most characters a user's
                                                       custom CSS may have
                                                       (default: 10000)
                                                       [$USER_STYLES_MAX_LENGTH]
          --page-size=                                 Items per page of the
                                                       feed, explore, the index
                                                       and a journal (default:
                                                       30) [$PAGE_SIZE]
          --rss-limit=                                 Items in every RSS
                                                       output (default: 50)
                                                       [$RSS_LIMIT]
          --max-body-size=                             Most bytes of a request
                                                       body; the upload routes
                                                       add their own cap to it
                                                       (default: 1048576)
                                                       [$MAX_BODY_SIZE]
          --max-upload-size=                           Most bytes of an
                                                       uploaded or imported
                                                       image (default:
                                                       20971520)
                                                       [$MAX_UPLOAD_SIZE]
          --max-import-size=                           Most bytes of a blog
                                                       archive to import
                                                       (default: 104857600)
                                                       [$MAX_IMPORT_SIZE]

    Login:
          --login-code-lifetime=                       How long a mailed login
                                                       code works (default:
                                                       15m)
                                                       [$LOGIN_CODE_LIFETIME]
          --login-code-tries=                          Wrong codes one login
                                                       attempt allows (default:
                                                       5) [$LOGIN_CODE_TRIES]
          --login-codes-mailed=                        Login codes mailed to
                                                       one user per
                                                       --login-codes-mailed-win-

                                                       dow (default: 3)
                                                       [$LOGIN_CODES_MAILED]
          --login-codes-mailed-window=                 Window of
                                                       --login-codes-mailed
                                                       (default: 15m)
                                                       [$LOGIN_CODES_MAILED_WIN-

                                                       DOW]
          --login-wrong-tries=                         Wrong codes on one
                                                       user's attempts per
                                                       --login-wrong-tries-wind-

                                                       ow before no code logs
                                                       them in (default: 10)
                                                       [$LOGIN_WRONG_TRIES]
          --login-wrong-tries-window=                  Window of
                                                       --login-wrong-tries
                                                       (default: 1h)
                                                       [$LOGIN_WRONG_TRIES_WIND-

                                                       OW]
          --login-unconfirmed-lifetime=                How long an account
                                                       nobody confirmed with a
                                                       code is kept (default:
                                                       24h)
                                                       [$LOGIN_UNCONFIRMED_LIFE-

                                                       TIME]
          --login-prune-every=                         How often old login
                                                       attempts and unconfirmed
                                                       accounts are deleted
                                                       (default: 1h)
                                                       [$LOGIN_PRUNE_EVERY]

    Email:
          --email-mx-timeout=                          How long the DNS lookups
                                                       of an address's domain
                                                       may take; 0 turns the
                                                       check off (default: 2s)
                                                       [$EMAIL_MX_TIMEOUT]
          --email-mx-cache=                            How long a domain the
                                                       DNS check accepted is
                                                       remembered (a refused
                                                       one is checked again
                                                       next time); 0 turns the
                                                       cache off (default: 1h)
                                                       [$EMAIL_MX_CACHE]
          --email-mx-cache-size=                       How many domains the DNS
                                                       check accepted are
                                                       remembered; 0 turns the
                                                       cache off (default:
                                                       10000)
                                                       [$EMAIL_MX_CACHE_SIZE]
          --email-allow-disposable=                    Accept throwaway
                                                       addresses on the
                                                       subscribe form; local
                                                       development only
                                                       (default: false)
                                                       [$EMAIL_ALLOW_DISPOSABLE]

    RSS feeds:
          --rss-poll-interval=                         How often feeds due for
                                                       a fetch are looked for
                                                       and queued (default:
                                                       10s) [$RSS_POLL_INTERVAL]
          --rss-fetch-timeout=                         How long fetching one
                                                       feed document may take
                                                       (default: 5s)
                                                       [$RSS_FETCH_TIMEOUT]
          --rss-image-timeout=                         How long downloading one
                                                       image of a feed item may
                                                       take (default: 30s)
                                                       [$RSS_IMAGE_TIMEOUT]
          --rss-max-feed-size=                         Most bytes of a feed
                                                       document (default:
                                                       5242880)
                                                       [$RSS_MAX_FEED_SIZE]

    User media:
          --user-media-endpoint=                       S3 endpoint URL
                                                       [$USER_MEDIA_ENDPOINT]
          --user-media-bucket=                         Bucket name
                                                       [$USER_MEDIA_BUCKET]
          --user-media-region=                         Bucket region
                                                       [$USER_MEDIA_REGION]
          --user-media-key=                            Access key ID
                                                       [$USER_MEDIA_KEY]
          --user-media-secret=                         Secret access key
                                                       [$USER_MEDIA_SECRET]
          --user-media-path-style=                     Path-style addressing
                                                       (endpoint/bucket/key),
                                                       as tommy needs (default:
                                                       false)
                                                       [$USER_MEDIA_PATH_STYLE]
          --user-media-cdn=                            Origin that serves user
                                                       media, such as
                                                       https://media.example;
                                                       served by the app if
                                                       empty [$USER_MEDIA_CDN]
          --user-media-timeout=                        How long one request to
                                                       the bucket may take
                                                       (default: 60s)
                                                       [$USER_MEDIA_TIMEOUT]

    Proofread:
          --proofread-anthropic-key=                   Anthropic API key;
                                                       grammar checks and style
                                                       reviews are off without
                                                       one
                                                       [$PROOFREAD_ANTHROPIC_KE-

                                                       Y]
          --proofread-anthropic-endpoint=              Anthropic API base URL
                                                       (default:
                                                       https://api.anthropic.co-

                                                       m)
                                                       [$PROOFREAD_ANTHROPIC_EN-

                                                       DPOINT]
          --proofread-grammar-model=                   Model of grammar checks
                                                       (default:
                                                       claude-haiku-5-5)
                                                       [$PROOFREAD_GRAMMAR_MODE-

                                                       L]
          --proofread-grammar-effort=[low|medium|high] Effort of grammar checks
                                                       (default: low)
                                                       [$PROOFREAD_GRAMMAR_EFFO-

                                                       RT]
          --proofread-style-model=                     Model of style reviews
                                                       (default:
                                                       claude-sonnet-5-5)
                                                       [$PROOFREAD_STYLE_MODEL]
          --proofread-style-effort=[low|medium|high]   Effort of style reviews
                                                       (default: medium)
                                                       [$PROOFREAD_STYLE_EFFORT]
          --proofread-grammar-per-hour=                Grammar checks one user
                                                       may make per hour
                                                       (default: 10)
                                                       [$PROOFREAD_GRAMMAR_PER_-

                                                       HOUR]
          --proofread-style-per-hour=                  Style reviews one user
                                                       may make per hour
                                                       (default: 3)
                                                       [$PROOFREAD_STYLE_PER_HO-

                                                       UR]
          --proofread-site-daily-requests=             Grammar checks and style
                                                       reviews the whole site
                                                       may make per day; 0 is
                                                       no cap (default: 0)
                                                       [$PROOFREAD_SITE_DAILY_R-

                                                       EQUESTS]
          --proofread-note-max-length=                 Most characters of an
                                                       author note to a style
                                                       review, or of a reason
                                                       to keep a note as is
                                                       (default: 2000)
                                                       [$PROOFREAD_NOTE_MAX_LEN-

                                                       GTH]
          --proofread-timeout=                         How long one request to
                                                       the Anthropic API may
                                                       take (default: 90s)
                                                       [$PROOFREAD_TIMEOUT]
          --proofread-grammar-max-tokens=              Most output tokens of a
                                                       grammar check (default:
                                                       8000)
                                                       [$PROOFREAD_GRAMMAR_MAX_-

                                                       TOKENS]
          --proofread-style-max-tokens=                Most output tokens of a
                                                       style review (default:
                                                       16000)
                                                       [$PROOFREAD_STYLE_MAX_TO-

                                                       KENS]

    Email subscriptions:
          --subscribe-confirm-lifetime=                How long a mailed
                                                       subscription
                                                       confirmation link works
                                                       (default: 72h)
                                                       [$SUBSCRIBE_CONFIRM_LIFE-

                                                       TIME]
          --subscribe-confirms-per-address=            Subscription
                                                       confirmation mails one
                                                       address may get
                                                       (default: 3)
                                                       [$SUBSCRIBE_CONFIRMS_PER-

                                                       _ADDRESS]
          --subscribe-manage-links-per-address=        Mails with the link to
                                                       manage subscriptions one
                                                       address may get
                                                       (default: 3)
                                                       [$SUBSCRIBE_MANAGE_LINKS-

                                                       _PER_ADDRESS]
          --subscribe-confirms-per-hour=               Subscription
                                                       confirmation mails the
                                                       whole site may send per
                                                       hour (default: 100)
                                                       [$SUBSCRIBE_CONFIRMS_PER-

                                                       _HOUR]
          --subscribe-domain-lookups-per-hour=         DNS lookups of
                                                       subscribing addresses'
                                                       domains the whole site
                                                       may make per hour; past
                                                       it addresses go
                                                       unchecked (default: 300)
                                                       [$SUBSCRIBE_DOMAIN_LOOKU-

                                                       PS_PER_HOUR]
          --subscribe-pow-difficulty=                  Leading zero bits of the
                                                       proof of work the
                                                       subscribe form's browser
                                                       solves (default: 15)
                                                       [$SUBSCRIBE_POW_DIFFICUL-

                                                       TY]
          --subscribe-pow-max-age=                     How long a proof-of-work
                                                       challenge may be
                                                       answered (default: 30m)
                                                       [$SUBSCRIBE_POW_MAX_AGE]
          --subscribe-min-fill-time=                   Least time between
                                                       showing the subscribe
                                                       form and submitting it
                                                       (default: 2s)
                                                       [$SUBSCRIBE_MIN_FILL_TIM-

                                                       E]
          --subscribe-prune-every=                     How often expired
                                                       subscriptions and old
                                                       subscription mail
                                                       records are deleted
                                                       (default: 1h)
                                                       [$SUBSCRIBE_PRUNE_EVERY]

    Notes:
          --note-body-max-length=                      Most characters a note
                                                       may have (default:
                                                       20000)
                                                       [$NOTE_BODY_MAX_LENGTH]
          --note-tag-max-length=                       Most characters of a
                                                       note tag (default: 40)
                                                       [$NOTE_TAG_MAX_LENGTH]
          --note-tags-max=                             Most tags set by hand on
                                                       one note (default: 10)
                                                       [$NOTE_TAGS_MAX]
          --note-source-title-max-length=              Most characters of the
                                                       title of a note's source
                                                       (default: 300)
                                                       [$NOTE_SOURCE_TITLE_MAX_-

                                                       LENGTH]
          --note-photo-max-dimension=                  Longest side in pixels a
                                                       note's photo is scaled
                                                       down to (default: 2048)
                                                       [$NOTE_PHOTO_MAX_DIMENSI-

                                                       ON]
          --note-audio-max-duration=                   Longest recording of one
                                                       note (default: 10m)
                                                       [$NOTE_AUDIO_MAX_DURATIO-

                                                       N]
          --note-audio-max-bytes=                      Most bytes of one note's
                                                       recording (default:
                                                       8388608)
                                                       [$NOTE_AUDIO_MAX_BYTES]
          --note-audio-bitrate=                        Bits per second the
                                                       browser records notes at
                                                       (default: 24000)
                                                       [$NOTE_AUDIO_BITRATE]
          --note-capture-max-bytes=                    Most bytes of one
                                                       capture with its photos
                                                       and recording (default:
                                                       33554432)
                                                       [$NOTE_CAPTURE_MAX_BYTES]
          --note-quote-source-window=                  How long after a note
                                                       with a source a new
                                                       quote still takes that
                                                       source (default: 12h)
                                                       [$NOTE_QUOTE_SOURCE_WIND-

                                                       OW]
          --note-panel-tags=                           How many of the author's
                                                       most used tags the post
                                                       editor's Notes panel
                                                       offers (default: 8)
                                                       [$NOTE_PANEL_TAGS]

    Speech to text:
          --stt-provider=[|openai-compat]              Speech-to-text backend;
                                                       empty turns
                                                       transcription off
                                                       [$STT_PROVIDER]
          --stt-timeout=                               How long one call to the
                                                       backend may take
                                                       (default: 2m)
                                                       [$STT_TIMEOUT]
          --stt-workers=                               How many transcriptions
                                                       run at once (default: 2)
                                                       [$STT_WORKERS]
          --stt-attempts=                              How many times a
                                                       transcription is tried
                                                       before the note is
                                                       marked failed (default:
                                                       5) [$STT_ATTEMPTS]
          --stt-minutes-per-day=                       Minutes of recordings
                                                       one user may have
                                                       transcribed per day
                                                       (default: 60)
                                                       [$STT_MINUTES_PER_DAY]
          --stt-site-minutes-per-day=                  Minutes of recordings
                                                       the whole site may have
                                                       transcribed per day; 0
                                                       is no cap (default: 0)
                                                       [$STT_SITE_MINUTES_PER_D-

                                                       AY]

    OpenAI-compatible speech-to-text:
          --stt-openai-compat-endpoint=                Base URL of the API
                                                       (default:
                                                       https://api.groq.com/ope-

                                                       nai/v1)
                                                       [$STT_OPENAI_COMPAT_ENDP-

                                                       OINT]
          --stt-openai-compat-model=                   Transcription model
                                                       (default:
                                                       whisper-large-v3-turbo)
                                                       [$STT_OPENAI_COMPAT_MODE-

                                                       L]
          --stt-openai-compat-key=                     API key; required with
                                                       --stt-provider=openai-co-

                                                       mpat
                                                       [$STT_OPENAI_COMPAT_KEY]

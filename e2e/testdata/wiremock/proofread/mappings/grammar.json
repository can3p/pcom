{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/anthropic/v1/messages",
    "headers": {
      "x-api-key": {
        "equalTo": "wiremock-anthropic-key"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.model",
          "equalTo": "claude-haiku-5-5"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.messages[0].content[0].text",
          "contains": "wm-e2e-grammar"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "msg_e2e",
      "type": "message",
      "role": "assistant",
      "model": "claude-haiku-5-5",
      "content": [
        {
          "type": "text",
          "text": "{\"suggestions\": [{\"field\": \"body\", \"kind\": \"spelling\", \"quote\": \"cta\", \"before\": \"I saw a \", \"replacement\": \"cat\", \"explanation\": \"Typo.\"}]}"
        }
      ],
      "stop_reason": "end_turn",
      "stop_sequence": null,
      "usage": {
        "input_tokens": 100,
        "output_tokens": 20,
        "cache_creation_input_tokens": 0,
        "cache_read_input_tokens": 0
      }
    }
  }
}
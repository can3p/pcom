{
  "mappings": [
    {
      "name": "list and link post",
      "request": {
        "method": "POST",
        "urlPath": "/azure-translator/translate",
        "queryParameters": {
          "api-version": {
            "equalTo": "3.0"
          },
          "from": {
            "equalTo": "de"
          },
          "to": {
            "equalTo": "en"
          },
          "textType": {
            "equalTo": "html"
          }
        },
        "headers": {
          "Content-Type": {
            "equalTo": "application/json; charset=UTF-8"
          },
          "Ocp-Apim-Subscription-Key": {
            "equalTo": "e2e-key"
          }
        },
        "bodyPatterns": [
          {
            "equalToJson": [
              {
                "Text": "Samstag mit Tobias"
              },
              {
                "Text": "Einkaufsliste für Tobias:"
              },
              {
                "Text": "Äpfel kaufen"
              },
              {
                "Text": "<a data-i=\"0\">Brot</a> holen"
              }
            ]
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": [
          {
            "translations": [
              {
                "text": "Saturday with Tobias",
                "to": "en"
              }
            ]
          },
          {
            "translations": [
              {
                "text": "Shopping list for Tobias:",
                "to": "en"
              }
            ]
          },
          {
            "translations": [
              {
                "text": "Buy apples",
                "to": "en"
              }
            ]
          },
          {
            "translations": [
              {
                "text": "<a data-i=\"0\">Get bread</a>",
                "to": "en"
              }
            ]
          }
        ]
      }
    },

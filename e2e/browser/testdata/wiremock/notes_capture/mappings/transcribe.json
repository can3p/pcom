{
  "request": {
    "method": "POST",
    "urlPath": "/notes-capture/audio/transcriptions",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer notes-capture-key"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "task": "transcribe",
      "language": "english",
      "duration": 2.0,
      "text": "Walking past the river I thought of the essay."
    }
  }
}

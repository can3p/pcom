{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/notes-capture/audio/transcriptions",
    "headers": {
      "Authorization": {
        "equalTo": "Bearer notes-capture-key"
      }
    },
    "bodyPatterns": [
      {
        "contains": "name=\"language\"\r\n\r\nru\r\n"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "task": "transcribe",
      "language": "russian",
      "duration": 20.0,
      "text": "Гуляя вдоль реки, я думал об эссе."
    }
  }
}
